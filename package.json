{
  "name": "zperiod",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "portless zsk-periodic-table vite",
    "build": "node scripts/validate-element-data.mjs && node scripts/generate-element-modules.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/validate-element-data.mjs && node scripts/generate-element-modules.mjs && tsc --noEmit",
    "data:check": "node scripts/validate-element-data.mjs",
    "data:generate": "node scripts/generate-element-modules.mjs",
    "data:prepare": "node scripts/validate-element-data.mjs && node scripts/generate-element-modules.mjs",
    "lint": "oxlint . --fix",
    "lint:check": "oxlint .",
    "fmt": "oxfmt . --write",
    "fmt:check": "oxfmt . --check"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@react-three/drei": "^10",
    "@react-three/fiber": "^9",
    "@tanstack/react-router": "^1.168.25",
    "@vanilla-extract/css": "^1.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "jspdf": "^2.5.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.165.0",
    "zsk-react-error": "^0.0.4",
    "zsk-react-i18n": "^0.0.5",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.28",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.165.0",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.3",
    "typescript": "^5",
    "vite": "^7.0.0",
    "vitest": "^4.1.5"
  }
}
